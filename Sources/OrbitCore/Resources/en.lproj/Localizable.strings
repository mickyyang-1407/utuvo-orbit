"orbit.help.tool.actions.body" = "Search every action in one place — tools, modes, audio scenes, snippets and quick links — and run it straight from the results.";
"orbit.help.tool.audio.body" = "Save the current output device, input device and volume as a scene, then apply it in one click when you switch setups.";
"orbit.help.tool.timer.body" = "A countdown or a 25/5 Pomodoro. It can keep the Mac awake while it runs, and notify you when it finishes.";
"orbit.help.tool.clocks.body" = "Keep several cities side by side and convert between them without leaving the page.";
"orbit.help.tool.reminders.body" = "A heads-up when the battery is low, the charger reached its target, an accessory is running down or the network drops. Off until you turn it on.";
"orbit.help.tool.clipboard.body" = "A clipboard history you can switch on. It stays off until you enable it, and it keeps nothing after you turn it off.";
"orbit.help.tool.notes.body" = "Quick notes that save as you type. Delete one and it stays in Recently Deleted, ready to be restored; export any note to Markdown.";
"orbit.help.tool.snippets.body" = "Reusable pieces of text with a keyword, so the action search can find and open them by name.";
"orbit.help.tool.links.body" = "Your own list of links and URL templates, kept next to the other tools.";
"orbit.help.tool.integrity.body" = "Check a file's checksum and read it back, to confirm a copy or a backup is really intact.";
"orbit.help.tool.text.body" = "Tidy text: trim lines, format JSON, encode URLs and compare strings. All of it happens on this Mac.";
"orbit.help.tool.calculator.body" = "Everyday arithmetic and unit conversion.";
"orbit.help.tool.files.body" = "Look at files, copy their path, and zip or unzip them. Originals are never overwritten.";
"orbit.help.tool.pdf.body" = "Merge, split, extract pages, rotate, and collect images into one document. The originals stay where they are.";
"orbit.help.tool.screenshots.body" = "Choose what to capture with the macOS picker, then crop, mark up, redact and run OCR on the result. Exports never touch the original.";
"orbit.help.tool.colors.body" = "Sample a colour from the screen, copy it as HEX or RGB, and keep a palette of the ones you like.";
"orbit.help.tool.qr.body" = "Turn text into a high-resolution QR code, or read a code out of an image or an edited screenshot. A link stays text — it is never opened for you.";
"orbit.help.workflows.title" = "Common flows";
"orbit.help.workflows.summary" = "How the tools hand work to each other.";
"orbit.help.workflow.screenshot.title" = "Screenshot to text";
"orbit.help.workflow.screenshot.body" = "Capture a window, crop and redact it, run OCR on the result, then send the text to the Text tools.";
"orbit.help.workflow.clipboard.title" = "Clipboard to a QR code";
"orbit.help.workflow.clipboard.body" = "Copy something, open the Clipboard page, and send the entry straight to the Text tools or to a QR code.";
"orbit.help.workflow.snippet.title" = "Snippet to a note";
"orbit.help.workflow.snippet.body" = "Keep a phrase as a snippet, then push it into a note when you need it in writing.";
"orbit.help.workflow.file.title" = "File to a checked path";
"orbit.help.workflow.file.body" = "Drop a file on the Files page, check it with File integrity, and copy its path into a note.";
"orbit.help.workflow.audio.title" = "A new audio setup";
"orbit.help.workflow.audio.body" = "Choose an output and a volume, save them as a scene, and apply that scene whenever you switch devices.";
"orbit.help.workflow.backup.title" = "Backing up what you wrote";
"orbit.help.workflow.backup.body" = "Notes, snippets and quick links can each be exported as a JSON backup and imported again later. An import only adds records — it never overwrites or deletes what you already have.";
"orbit.help.shortcuts.title" = "Keyboard";
"orbit.help.shortcuts.summary" = "The keys Orbit uses for itself. It replaces no system shortcut.";
"orbit.help.shortcut.help.title" = "⌘? — this guide";
"orbit.help.shortcut.help.body" = "Opens the help. It works whenever UTUVO Orbit is the frontmost app, and it registers no global shortcut.";
"orbit.help.shortcut.edit.title" = "⌘Z ⇧⌘Z ⌘X ⌘C ⌘V ⌘A — editing";
"orbit.help.shortcut.edit.body" = "Undo, redo, cut, copy, paste and select all, in whatever field you are typing in.";
"orbit.help.shortcut.actions.title" = "⌘K — search actions";
"orbit.help.shortcut.actions.body" = "Search every action from inside the workbench.";
"orbit.help.shortcut.save.title" = "⌘S — save";
"orbit.help.shortcut.save.body" = "Save the note or the snippet you are editing.";
"orbit.help.shortcut.escape.title" = "Esc — close the panel";
"orbit.help.shortcut.escape.body" = "Close the panel, whichever way it is open.";
"orbit.help.shortcut.quit.title" = "⌘Q — quit";
"orbit.help.shortcut.quit.body" = "Quit UTUVO Orbit.";
"orbit.help.shortcut.clothesline.title" = "⌃⌥T — the screenshot clothesline";
"orbit.help.shortcut.clothesline.body" = "Show or hide the screenshot clothesline — only while that module is switched on.";
"orbit.help.privacy.title" = "Privacy and your data";
"orbit.help.privacy.summary" = "What Orbit does with your Mac, and what it leaves alone.";
"orbit.help.privacy.local.title" = "Everything stays local";
"orbit.help.privacy.local.body" = "Everything in the workbench runs on this Mac. There is no account, no purchase and no analytics, and the tools do not call out to the network.";
"orbit.help.privacy.login.title" = "Open at login";
"orbit.help.privacy.login.body" = "“Open at login” is off by default. Turning it on adds a login item that only puts the icon in the menu bar — no extra window opens.";
"orbit.help.privacy.modules.title" = "Optional modules";
"orbit.help.privacy.modules.body" = "The file shelf and the screenshot clothesline are off by default. Switching one on is the only thing it takes.";
"orbit.help.privacy.clipboard.title" = "Clipboard and notifications";
"orbit.help.privacy.clipboard.body" = "Clipboard history, notifications and reminders are opt-in. When you switch the clipboard off, the history is cleared.";
"orbit.help.privacy.capture.title" = "What screen capture asks for";
"orbit.help.privacy.capture.body" = "Screenshots are captured with the macOS picker. You choose the window or content each time, and macOS asks for your confirmation — Orbit never records the whole screen on its own, and the picker does not need a broad screen-recording permission.";
"orbit.help.privacy.updates.title" = "Updates";
"orbit.help.privacy.updates.body" = "Update checks are off until you ask for them, and an update is only installed after its signature checks out.";
"orbit.help.privacy.data.title" = "Where your files are, and how to get them back";
"orbit.help.privacy.data.body" = "Notes, snippets, quick links, scenes, palettes and reminders live in this Mac's application support folder. If a file ever stops reading, Orbit keeps the damaged original and asks you to back it up before resetting. Notes, snippets and quick links can be exported as a JSON backup and imported again.";
"orbit.help.links.title" = "Official sources (optional)";
"orbit.help.links.summary" = "None of this is needed to use Orbit. A link opens only when you press the button — Orbit never loads it by itself and sends nothing with it.";
"orbit.help.links.open" = "Open";
"orbit.help.links.openLabel" = "Open ";
"orbit.help.links.repository.title" = "Source code";
"orbit.help.links.repository.body" = "The public repository for UTUVO Orbit. The whole app is free and MIT-licensed.";
"orbit.help.links.apple.title" = "About the macOS capture picker";
"orbit.help.links.apple.body" = "Apple's own documentation for ScreenCaptureKit, including the content picker Orbit uses.";
